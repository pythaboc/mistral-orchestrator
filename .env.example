# --- Mistral AI ---
# Récupère ta clé sur https://console.mistral.ai/ (section API Keys)
MISTRAL_API_KEY=ta_cle_api_mistral_ici

# --- Modèles par rôle ---
ORCHESTRATOR_MODEL=mistral-large-latest
CODER_MODEL=mistral-medium-latest
VERIFIER_MODEL=mistral-medium-latest
RESEARCHER_MODEL=mistral-medium-latest
WATCHER_MODEL=mistral-small-latest
SCRIBE_MODEL=mistral-small-latest

# --- Budget mensuel adaptatif ---
# Budget mensuel en tokens (25,50 € d'API ≈ 17M tokens à prix moyen mixte)
MONTHLY_TOKEN_BUDGET=17000000
# Réserve de sécurité : on ne touche jamais à ça (limite à ne pas franchir)
SAFETY_RESERVE_TOKENS=500000
# Fenêtre glissante en jours
BUDGET_WINDOW_DAYS=30

# --- Budget session (veilleur) ---
MAX_TOKENS_PER_SESSION=1000000
ALERT_THRESHOLD_PCT=70
MAX_AGENT_CALLS=20

# --- Gestion du contexte (résumé auto) ---
# Seuil en tokens au-delà duquel le scribe résume l'historique
CONTEXT_THRESHOLD_TOKENS=8000
# Nombre de messages récents à garder après résumé
CONTEXT_KEEP_RECENT=4

# --- Monitoring (optionnel) ---
PROMETHEUS_PORT=8000

# --- Interface web ---
WEB_PORT=5000
