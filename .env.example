# --- Mistral AI ---
# Récupère ta clé sur https://console.mistral.ai/ (section API Keys)
MISTRAL_API_KEY=ta_cle_api_mistral_ici

# --- Modèles par rôle (voir docs.mistral.ai/getting-started/models/models_overview) ---
# Orchestrateur (coordinateur, le plus capable)
ORCHESTRATOR_MODEL=mistral-large-latest
# Codeurs et vérificateur (optimisés code/agentic, dialogue natif)
CODER_MODEL=mistral-medium-latest
VERIFIER_MODEL=mistral-medium-latest
# Chercheur (websearch + synthèse)
RESEARCHER_MODEL=mistral-medium-latest
# Veilleur (léger, peu coûteux, surveille les tokens)
WATCHER_MODEL=mistral-small-latest
# Scribe (léger, enregistre les décisions)
SCRIBE_MODEL=mistral-small-latest

# --- Veilleur : seuils de consommation (drastique) ---
# Budget total en tokens pour UNE session de travail
MAX_TOKENS_PER_SESSION=200000
# Seuil d'alerte (en % du budget)
ALERT_THRESHOLD_PCT=70
# Nombre max d'appels à un agent avant de soupçonner une boucle
MAX_AGENT_CALLS=15

# --- Monitoring (optionnel) ---
PROMETHEUS_PORT=8000
